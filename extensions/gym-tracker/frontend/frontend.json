{
  "id": "gym-tracker",
  "version": "2.7.8",
  "entrypoint": "gym-tracker-components.umd.cjs",
  "components": [
    {
      "name": "GymLiveState",
      "type": "card",
      "displayName": "Gym · Live",
      "description": "Current in-gym presence and tracks",
      "icon": "users",
      "defaultSize": { "width": 340, "height": 260 },
      "minSize": { "width": 240, "height": 180 },
      "refreshable": true,
      "refreshInterval": 2000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": ["extension", "extension-command"],
      "configSchema": {}
    }
  ],
  "i18n": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "zh"]
  },
  "dependencies": {
    "react": ">=18.0.0"
  }
}
