{
  "id": "gym-tracker",
  "version": "2.10.0",
  "entrypoint": "gym-tracker-components.umd.cjs",
  "components": [
    {
      "name": "GymLiveState",
      "type": "card",
      "displayName": "Gym · Live",
      "description": "Current in-gym presence and tracks",
      "icon": "users",
      "defaultSize": {
        "width": 340,
        "height": 260
      },
      "minSize": {
        "width": 240,
        "height": 180
      },
      "refreshable": true,
      "refreshInterval": 2000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "maxRows": {
          "type": "number",
          "default": 12,
          "minimum": 4,
          "maximum": 40,
          "description": "会员/轨迹列表最多显示行数"
        }
      },
      "category": "custom"
    },
    {
      "name": "GymEquipmentGrid",
      "type": "gym-equipment-grid",
      "displayName": "Gym · Equipment",
      "description": "Equipment-zone occupancy board (computed from live tracks + ROI zones)",
      "icon": "grid",
      "defaultSize": {
        "width": 420,
        "height": 300
      },
      "minSize": {
        "width": 280,
        "height": 200
      },
      "refreshable": true,
      "refreshInterval": 2000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "showIdle": {
          "type": "boolean",
          "default": true,
          "description": "显示空闲器械（关闭则只看占用中的）"
        },
        "busySec": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "占用判定阈值（秒）：同一人持续停留该时长才计为占用中"
        }
      },
      "category": "custom"
    },
    {
      "name": "GymTrafficChart",
      "type": "gym-traffic-chart",
      "displayName": "Gym · Traffic",
      "description": "Presence trend over the last N hours (gym.present_count history)",
      "icon": "line-chart",
      "defaultSize": {
        "width": 420,
        "height": 260
      },
      "minSize": {
        "width": 280,
        "height": 180
      },
      "refreshable": true,
      "refreshInterval": 30000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "hours": {
          "type": "number",
          "default": 6,
          "description": "Trend window in hours (1-24)",
          "minimum": 1,
          "maximum": 24
        }
      },
      "category": "custom"
    },
    {
      "name": "GymWorkoutSummary",
      "type": "gym-workout-summary",
      "displayName": "Gym · 运动概况",
      "description": "Daily workout analytics: total training time, visits, equipment usage ranking, session list",
      "icon": "clock",
      "defaultSize": {
        "width": 420,
        "height": 360
      },
      "minSize": {
        "width": 300,
        "height": 240
      },
      "refreshable": true,
      "refreshInterval": 10000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {},
      "category": "custom"
    },
    {
      "name": "GymVideoOverlay",
      "type": "gym-video-overlay",
      "displayName": "Gym · Monitor",
      "description": "All-in-one gym monitor: live video + AI overlay (bbox/skeleton) + zone drawing on the real scene + live occupancy badges",
      "icon": "video",
      "defaultSize": {
        "width": 760,
        "height": 560
      },
      "minSize": {
        "width": 420,
        "height": 320
      },
      "maxSize": {
        "width": 1400,
        "height": 1000
      },
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "showBoxes": {
          "type": "boolean",
          "default": true,
          "description": "默认显示检测框"
        },
        "showSkeleton": {
          "type": "boolean",
          "default": true,
          "description": "默认显示骨架关键点"
        },
        "showTrails": {
          "type": "boolean",
          "default": true,
          "description": "默认显示运动轨迹"
        }
      },
      "category": "custom"
    },
    {
      "name": "GymEquipmentRank",
      "type": "gym-equipment-rank",
      "displayName": "Gym · 器械排行",
      "description": "今日各器械使用时长排行（条形图，含次数）",
      "icon": "bar-chart",
      "defaultSize": {
        "width": 420,
        "height": 300
      },
      "minSize": {
        "width": 280,
        "height": 160
      },
      "refreshable": true,
      "refreshInterval": 15000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "topN": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 20,
          "description": "显示前 N 台"
        }
      }
    },
    {
      "name": "GymMemberReport",
      "type": "gym-member-report",
      "displayName": "Gym · 会员周报",
      "description": "会员到店次数/时长/最近到店（近 N 天）",
      "icon": "users",
      "defaultSize": {
        "width": 420,
        "height": 300
      },
      "minSize": {
        "width": 280,
        "height": 160
      },
      "refreshable": true,
      "refreshInterval": 15000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "days": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 90,
          "description": "统计窗口（天）"
        }
      }
    },
    {
      "name": "GymAlerts",
      "type": "gym-alerts",
      "displayName": "Gym · 告警",
      "description": "实时安全告警：疑似跌倒、器械久占",
      "icon": "alert-triangle",
      "defaultSize": {
        "width": 420,
        "height": 260
      },
      "minSize": {
        "width": 280,
        "height": 160
      },
      "refreshable": true,
      "refreshInterval": 15000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": [
        "extension",
        "extension-command"
      ],
      "configSchema": {
        "onlyWarn": {
          "type": "boolean",
          "default": false,
          "description": "只显示警示级（跌倒）告警"
        }
      }
    }
  ],
  "i18n": {
    "defaultLanguage": "en",
    "supportedLanguages": [
      "en",
      "zh"
    ]
  },
  "dependencies": {
    "react": ">=18.0.0"
  }
}