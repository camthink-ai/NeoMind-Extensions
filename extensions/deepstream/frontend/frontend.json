{
  "id": "deepstream",
  "version": "2.7.7",
  "entrypoint": "deepstream-components.umd.cjs",
  "components": [
    {
      "name": "DeepStreamStatsCard",
      "type": "card",
      "displayName": "DeepStream System Status",
      "description": "Sidecar status, GPU utilization/memory, active stream count, total throughput FPS, and restart control.",
      "icon": "cpu",
      "defaultSize": { "width": 340, "height": 240 },
      "minSize": { "width": 260, "height": 200 },
      "maxSize": { "width": 500, "height": 400 },
      "refreshable": true,
      "refreshInterval": 5000,
      "hasDataSource": false,
      "configSchema": {
        "title": {
          "type": "string",
          "title": "Card Title",
          "description": "Override the default title text",
          "default": "DeepStream"
        },
        "serverHost": {
          "type": "string",
          "title": "DeepStream Server Address",
          "description": "IP or hostname where the DeepStream sidecar runs (e.g. Jetson device IP 192.168.93.20). Leave empty to use the current page hostname."
        },
        "snapshotPort": {
          "type": "number",
          "title": "Snapshot Port",
          "description": "Sidecar snapshot HTTP port, default 8555",
          "default": 8555
        },
        "rtspPort": {
          "type": "number",
          "title": "RTSP Port",
          "description": "RTSP output port, default 8554",
          "default": 8554
        }
      },
      "uiHints": {
        "fieldOrder": ["title", "serverHost", "snapshotPort", "rtspPort"]
      }
    },
    {
      "name": "DeepStreamOverviewCard",
      "type": "card",
      "displayName": "DeepStream Stream Overview",
      "description": "Thumbnail grid of all video streams with live snapshot polling and status indicators. Click a thumbnail to view single-stream details.",
      "icon": "video",
      "defaultSize": { "width": 680, "height": 480 },
      "minSize": { "width": 400, "height": 300 },
      "maxSize": { "width": 1200, "height": 800 },
      "refreshable": true,
      "refreshInterval": 5000,
      "hasDataSource": false,
      "configSchema": {
        "title": {
          "type": "string",
          "title": "Card Title",
          "default": "DeepStream Streams"
        },
        "serverHost": {
          "type": "string",
          "title": "DeepStream Server Address",
          "description": "IP or hostname where the DeepStream sidecar runs. Leave empty to use the current page hostname."
        },
        "snapshotPort": {
          "type": "number",
          "title": "Snapshot Port",
          "default": 8555
        },
        "rtspPort": {
          "type": "number",
          "title": "RTSP Port",
          "default": 8554
        },
        "snapshotToken": {
          "type": "string",
          "title": "Snapshot Auth Token",
          "description": "Required for live thumbnail polling. Leave empty to show placeholders only."
        }
      },
      "uiHints": {
        "fieldOrder": ["title", "serverHost", "snapshotPort", "rtspPort", "snapshotToken"]
      }
    },
    {
      "name": "DeepStreamStreamCard",
      "type": "card",
      "displayName": "DeepStream Stream Detail",
      "description": "Large snapshot, copyable RTSP URL, real-time counts (persons/vehicles/line-cross/ROI alerts), and event feed.",
      "icon": "video",
      "defaultSize": { "width": 500, "height": 680 },
      "minSize": { "width": 360, "height": 480 },
      "maxSize": { "width": 800, "height": 1000 },
      "refreshable": true,
      "refreshInterval": 5000,
      "hasDataSource": true,
      "dataSourceAllowedTypes": ["extension-command"],
      "configSchema": {
        "title": {
          "type": "string",
          "title": "Card Title",
          "description": "Defaults to the bound stream_id"
        },
        "streamId": {
          "type": "string",
          "title": "Stream ID",
          "description": "The stream to display. Overrides data source binding."
        },
        "serverHost": {
          "type": "string",
          "title": "DeepStream Server Address",
          "description": "IP or hostname where the DeepStream sidecar runs. Leave empty to use the current page hostname."
        },
        "snapshotPort": {
          "type": "number",
          "title": "Snapshot Port",
          "default": 8555
        },
        "rtspPort": {
          "type": "number",
          "title": "RTSP Port",
          "default": 8554
        },
        "snapshotToken": {
          "type": "string",
          "title": "Snapshot Auth Token",
          "description": "Required for live snapshot polling."
        }
      },
      "uiHints": {
        "fieldOrder": ["title", "streamId", "serverHost", "snapshotPort", "rtspPort", "snapshotToken"]
      }
    }
  ],
  "i18n": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "zh"]
  },
  "dependencies": {
    "react": ">=18.0.0"
  }
}
